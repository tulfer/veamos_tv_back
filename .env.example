# Server
PORT=8080
NODE_ENV=development
HOST=0.0.0.0

# Firebase
FIREBASE_PROJECT_ID=veamos-tv
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Scraping
SCRAPE_INTERVAL_MINUTES=30

# Fallback de extracción (Cloud Run, último recurso)
# FALLBACK_EXTRACT_URL=https://veamos-tv-backend-xxxx-uc.a.run.app
# FALLBACK_EXTRACT_KEY=clave-compartida-con-cloud-run
