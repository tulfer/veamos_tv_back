# Server
PORT=8080
NODE_ENV=development
HOST=0.0.0.0

# Supabase (Postgres) — reemplaza Firebase/Firestore
# Cadena de conexión de Supabase (puerto default Postgres 5432, NO 8080):
DATABASE_URL=postgres://postgres:TU_PASSWORD@86.48.23.214:5432/postgres
# Secreto de firma de los tokens de Supabase Auth (usado en /auth/supabase)
SUPABASE_JWT_SECRET=

# Firebase admin — SOLO para migrar Firestore -> Supabase desde el dashboard.
# Usa una de estas dos opciones:
#  A) Service account JSON (recomendado): GOOGLE_APPLICATION_CREDENTIALS=ruta (solo local)
#  B) Variables del SA:
# FIREBASE_PROJECT_ID=veamos-tv
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@veamos-tv.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_DATABASE_URL=https://veamos-tv.firebaseio.com

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Scraping
SCRAPE_INTERVAL_MINUTES=30

# Fallback de extracción (Cloud Run, último recurso)
# FALLBACK_EXTRACT_URL=https://veamos-tv-backend-xxxx-uc.a.run.app
# FALLBACK_EXTRACT_KEY=clave-compartida-con-cloud-run
