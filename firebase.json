{
  "hosting": {
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "appHosting": {
      "appId": "veamos-tv",
      "region": "us-central1"
    }
  },
  "functions": {
    "source": ".",
    "runtime": "nodejs20",
    "ignore": [
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
